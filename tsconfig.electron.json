{
    "compilerOptions": {
        "target": "es2023",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "dist-electron",
        "rootDir": "electron",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": false,
        "declaration": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["electron"]
}
